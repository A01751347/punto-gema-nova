# Database
DATABASE_URL="postgresql://user:password@host/punto_gema_nova?sslmode=require"

# AWS Cognito
AWS_REGION="us-east-2"
AWS_COGNITO_USER_POOL_ID="your-user-pool-id"
AWS_COGNITO_CLIENT_ID="your-client-id"
AWS_COGNITO_CLIENT_SECRET=""
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"

# AWS S3
AWS_S3_BUCKET_NAME="punto-gema-nova-images"
AWS_S3_REGION="us-east-2"

# Email (SMTP or AWS SES)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM_EMAIL="noreply@puntogemanova.com"
SMTP_FROM_NAME="Punto Gema Nova"

# Payment Gateways
MERCADOPAGO_ACCESS_TOKEN="your-mercadopago-access-token"
MERCADOPAGO_PUBLIC_KEY="your-mercadopago-public-key"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Punto Gema Nova"

# Admin
ADMIN_EMAIL="admin@puntogemanova.com"

# Session Secret (generate a random string)
SESSION_SECRET="your-session-secret-here-change-this"
