// Prisma schema — Punto Gema Nova (Joyería Artesanal)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model (linked to AWS Cognito)
model User {
  id               String    @id @default(uuid())
  cognitoId        String    @unique
  email            String    @unique
  firstName        String?
  lastName         String?
  phone            String?
  role             UserRole  @default(CUSTOMER)
  stylePreferences String[]  // style quiz preferences
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  orders        Order[]
  addresses     Address[]
  reviews       Review[]
  quizResults   QuizResult[]

  @@map("users")
}

enum UserRole {
  CUSTOMER
  ADMIN
  EDITOR
}

// Product model
model Product {
  id                String    @id @default(uuid())
  slug              String    @unique
  name              String
  tagline           String?
  description       String
  price             Float
  compareAtPrice    Float?    // original price for discounts
  size              String    // e.g., "18cm", "45cm"
  sku               String    @unique
  stock             Int       @default(0)
  lowStockThreshold Int       @default(10)
  isActive          Boolean   @default(true)
  isFeatured        Boolean   @default(false)
  isNew             Boolean   @default(false)
  isBestseller      Boolean   @default(false)

  // Product details
  benefits          String[]  // key benefits
  careInstructions  String    // how to care for the piece

  // Jewelry-specific fields
  material          String?   // "Chapa de oro 18k", "Plata .925"
  stoneType         String?   // "Cuarzo rosa", "Amatista", "Perla de río"
  isCustomizable    Boolean   @default(false)
  availabilityLabel String?   // "Disponible", "Última pieza", "Bajo pedido"
  collectionType    String?   // "permanente", "casi-unica", "personalizado", "temporada"

  // Media
  images            String[]  // S3 URLs
  videoUrl          String?   // S3 URL for demo video

  // SEO
  metaTitle         String?
  metaDescription   String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  categories        ProductCategory[]
  materials         ProductMaterial[]
  orderItems        OrderItem[]
  reviews           Review[]
  bundleProducts    BundleProduct[]

  @@map("products")
}

// Category model
model Category {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)

  // Relations
  products    ProductCategory[]

  @@map("categories")
}

// Many-to-many relation between Product and Category
model ProductCategory {
  productId   String
  categoryId  String

  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

// Material model (stones, metals, pearls, etc.)
model Material {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  description String
  benefits    String[]
  type        String?   // "piedra", "metal", "perla", "hilo"
  origin      String?   // "Brasil", "México", "India"

  // Relations
  products    ProductMaterial[]

  @@map("materials")
}

// Many-to-many relation between Product and Material
model ProductMaterial {
  productId   String
  materialId  String
  isPrimary   Boolean   @default(false)

  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  material    Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([productId, materialId])
  @@map("product_materials")
}

// Address model
model Address {
  id          String    @id @default(uuid())
  userId      String
  firstName   String
  lastName    String
  company     String?
  address1    String
  address2    String?
  city        String
  state       String
  postalCode  String
  country     String    @default("MX")
  phone       String
  isDefault   Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@map("addresses")
}

// Order model
model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  userId          String?
  guestEmail      String?

  // Shipping
  shippingAddressId String?
  shippingAddress   Address?  @relation(fields: [shippingAddressId], references: [id])
  shippingMethod    String
  shippingCost      Float

  // Pricing
  subtotal        Float
  discount        Float       @default(0)
  tax             Float       @default(0)
  total           Float

  // Payment
  paymentMethod   String      // mercadopago
  paymentStatus   PaymentStatus @default(PENDING)
  paymentId       String?     // external payment ID

  // Order status
  status          OrderStatus @default(PENDING)
  trackingNumber  String?

  // Coupon
  couponCode      String?

  // Notes
  customerNotes   String?
  adminNotes      String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  user            User?       @relation(fields: [userId], references: [id])
  items           OrderItem[]
  invoiceRequest  InvoiceRequest?

  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Order item model
model OrderItem {
  id          String    @id @default(uuid())
  orderId     String
  productId   String

  name        String    // snapshot of product name
  sku         String    // snapshot of SKU
  price       Float     // snapshot of price
  quantity    Int

  createdAt   DateTime  @default(now())

  // Relations
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// Review model
model Review {
  id          String    @id @default(uuid())
  productId   String
  userId      String

  rating      Int       // 1-5
  title       String?
  comment     String
  images      String[]  // S3 URLs for customer photos
  isVerified  Boolean   @default(false)
  isApproved  Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

// Product bundle / set model
model Bundle {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  description String
  price       Float
  compareAtPrice Float?
  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  products    BundleProduct[]

  @@map("bundles")
}

// Many-to-many relation between Bundle and Product
model BundleProduct {
  bundleId    String
  productId   String
  quantity    Int       @default(1)

  bundle      Bundle    @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([bundleId, productId])
  @@map("bundle_products")
}

// Style quiz model
model QuizResult {
  id          String    @id @default(uuid())
  userId      String?

  // Quiz answers
  styleType   String            // "minimalista", "bohemio", "clasico", "atrevido"
  occasions   String[]          // "diario", "regalo", "fiesta", "oficina"
  priceRange  String?           // budget preference
  preferences Json?             // material/color preferences

  // Recommendations
  recommendedProducts   String[]  // product IDs
  recommendedCollection String?   // collection type

  createdAt   DateTime  @default(now())

  // Relations
  user        User?     @relation(fields: [userId], references: [id])

  @@map("quiz_results")
}

// Coupon model
model Coupon {
  id          String    @id @default(uuid())
  code        String    @unique
  description String?

  discountType String   // percentage, fixed
  discountValue Float

  minPurchase Float?
  maxDiscount Float?

  usageLimit  Int?
  usageCount  Int       @default(0)

  startsAt    DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("coupons")
}

// Blog post model
model BlogPost {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String
  featuredImage String?

  category    String?
  tags        String[]

  isPublished Boolean   @default(false)
  publishedAt DateTime?

  // SEO
  metaTitle   String?
  metaDescription String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("blog_posts")
}

// Newsletter subscriber model
model NewsletterSubscriber {
  id          String    @id @default(uuid())
  email       String    @unique
  firstName   String?
  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())

  @@map("newsletter_subscribers")
}

// Banner/content model for homepage
model Banner {
  id          String    @id @default(uuid())
  title       String
  subtitle    String?
  ctaText     String?
  ctaLink     String?

  imageUrl    String?   // S3 URL
  videoUrl    String?   // S3 URL

  position    String    // hero, featured, etc.
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("banners")
}

// Invoice request model
model InvoiceRequest {
  id              String      @id @default(uuid())
  orderId         String      @unique

  // Fiscal Data
  rfc             String
  razonSocial     String
  regimenFiscal   String
  usoCfdi         String
  cp              String
  email           String

  // Status
  status          InvoiceStatus @default(PENDING)
  xmlUrl          String?
  pdfUrl          String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  order           Order       @relation(fields: [orderId], references: [id])

  @@map("invoice_requests")
}

enum InvoiceStatus {
  PENDING
  GENERATED
  FAILED
}

// Store configuration
model StoreSettings {
  id                        String      @id @default("default")
  orderNotificationEmails   String[]    @default([])
  invoiceNotificationEmails String[]    @default([])

  updatedAt                 DateTime    @updatedAt

  @@map("store_settings")
}
